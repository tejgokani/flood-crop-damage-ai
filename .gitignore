# Environments
.venv/
.uvcache/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Dataset cache, fetched on demand -- never committed.
# Anchored with a leading slash: an unanchored 'data/' would also swallow src/fcda/data/.
/data/
!/data/.gitkeep

# Training artefacts
checkpoints/
*.pt
*.pth

# Generated reports keep their structure but not their heavy outputs
/reports/figures/*.png
!/reports/figures/.gitkeep

# OS
.DS_Store
